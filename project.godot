; Engine configuration file.
; NEXMAX CHRONICLE ― はじまりの未来 ― 序章 縦型試作
; 条件：Godot 4 Standard / GDScript / Compatibility 描画（Web書き出し対応）

config_version=5

[application]

config/name="NEXMAX CHRONICLE ― はじまりの未来 ―"
config/description="IDOで過去を探り、NMClawで介入し、仲間と未来の道を開く3Dアクション（序章試作）"
config/version="0.6.0"
run/main_scene="res://scenes/ui/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.08, 0.16, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
TimelineState="*res://scripts/systems/timeline_state.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Hud="*res://scenes/ui/HUD.tscn"
TimeTravel="*res://scripts/systems/time_travel_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/NotoSansJP-Regular.ttf"

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.05, 0.08, 0.16, 1)
